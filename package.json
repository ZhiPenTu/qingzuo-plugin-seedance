{
  "name": "@commerce/plugin-seedance",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "commerce": {
    "manifestVersion": 1,
    "id": "official.seedance",
    "title": "Seedance 视频生成",
    "description": "基于 Seedance 2.5 模型生成高质量视频，支持文生视频与首帧图生视频",
    "category": "视频生成",
    "api": "^1.2.0",
    "ui": "ui/index.html",
    "releaseNotes": "新增专属品牌图标，统一插件市场、工具中心与插件管理的视觉呈现。",
    "permissions": {
      "files": true,
      "credentials": [
        "volcengine-ark-key"
      ],
      "network": [
        "https://ark.cn-beijing.volces.com"
      ]
    },
    "icon": "data:image/png;base64,"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/pack-plugin.mjs"
  },
  "dependencies": {
    "@commerce/plugin-sdk": "file:vendor/commerce-plugin-sdk-1.2.0.tgz"
  },
  "license": "MIT"
